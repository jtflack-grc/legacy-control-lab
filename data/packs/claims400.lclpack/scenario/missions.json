{
  "missions": [
    {
      "id": "CLAIMS-001",
      "title": "Can You Prove IBM i Security?",
      "persona": "IT auditor / GRC analyst",
      "briefing": "The control owner claims privileged access on CLAIMS400 is reviewed quarterly, restricted to approved administrators, and monitored through audit logging. Sign on as AUDIT, inspect the available evidence, and determine whether the control claim is defensible."
    },
    {
      "id": "OPERATOR-SESSION",
      "title": "Privileged Operator Session",
      "persona": "Security officer",
      "briefing": "Runtime tracking for QSECOFR administration — audit journal, job log, and state diff side effects."
    },
    {
      "id": "CLAIMS-002",
      "title": "Can You Prove Offboarding Hygiene?",
      "persona": "IT auditor / GRC analyst",
      "briefing": "The control owner claims contractor and vendor access is revoked within 90 days of departure and that dormant IBM i profiles are reviewed on schedule. Sign on as AUDIT to inspect dormant accounts (especially OLDVENDOR). Sign on as QSECOFR to run inactive analysis, exempt justified profiles, disable stale IDs, and confirm audit journal evidence."
    },
    {
      "id": "CLAIMS-003",
      "title": "Can You Prove Privacy Operations?",
      "persona": "IT auditor / GRC analyst",
      "briefing": "The control owner claims payroll PII on CLAIMS400 is governed through object authority, file design, scheduled batch jobs, and controlled IFS integration paths. Sign on as AUDIT and follow the ISO 27701 Clause 8 evidence chain: DSPOBJAUT and DSPFD on PAYROLL/PAYMST, WRKJOBSCDE for payroll batch, WRKLNK under /payroll, and DSPJRN for access monitoring."
    },
    {
      "id": "CLAIMS-004",
      "title": "Can You Prove Privacy Risk Planning?",
      "persona": "IT auditor / GRC analyst",
      "briefing": "The control owner claims privacy risks on CLAIMS400 are planned through authorization lists, profile authorities, and measurable audit monitoring. Sign on as AUDIT and walk ISO 27701 Clause 6: WRKAUTL and DSPAUTL on PAYROLL, DSPAUT on privileged profiles, DSPSECAUD or DSPAUDJRNE, and DSPJRN to test whether monitoring objectives are met."
    },
    {
      "id": "CLAIMS-005",
      "title": "Can You Blue Team IBM i?",
      "persona": "IT auditor / SOC analyst",
      "briefing": "The control owner claims security events on CLAIMS400 are detected and reviewable through active job monitoring, filtered audit journal views, job logs, and QAUDJRN. Sign on as AUDIT and follow the Blue Team article path: WRKACTJOB for suspicious batch work, DSPAUDJRNE for AF/PW events, DSPSECAUD, DSPJOBLOG, and DSPJRN — then write what you would escalate."
    },
    {
      "id": "CLAIMS-006",
      "title": "Can You Prove Profile Ownership?",
      "persona": "IT auditor / privacy analyst",
      "briefing": "The control owner claims payroll and claims data on CLAIMS400 has named accountability in user profiles. Sign on as AUDIT and walk ISO 27701 Clause 5: WRKUSRPRF, DSPUSRPRF PAYADMIN, RUNSQL against QSYS2.USER_INFO, and WRKFINDING with decision impact — is a data owner actually named for PII-touching profiles?"
    },
    {
      "id": "CLAIMS-007",
      "title": "Can You Red Team IBM i Boundaries?",
      "persona": "Adversarial simulation / internal audit",
      "briefing": "You are simulating a limited insider (APCLERK with LMTCPB(*YES)). Sign on as APCLERK / TRAIN. Inspect your own profile, attempt privilege escalation on PAYROLL/PAYMST (GRTOBJAUT or EDTOBJAUT), and review network attributes. Document escape attempts as findings — the lab blocks exploits but should prove boundary controls."
    },
    {
      "id": "CLAIMS-008",
      "title": "Can You Map SOC 2 to the Green Screen?",
      "persona": "IT auditor / GRC analyst",
      "briefing": "The control owner claims SOC 2 CC6/CC7 logical access and monitoring controls are supported by IBM i evidence. Sign on as AUDIT and map Trust Services criteria to green-screen proof: profiles, object authority, audit journal, and detect/respond signals."
    },
    {
      "id": "CLAIMS-009",
      "title": "Can You See Tail Risk on the Green Screen?",
      "persona": "IT auditor / resilience analyst",
      "briefing": "Leadership claims CLAIMS400 is stable because interactive uptime looks fine. Sign on as AUDIT and walk the Black Swan path: WRKSBMJOB for failed/held batch, DSPJOB, WRKACTJOB for vendor batch work, WRKSYSSTS, DSPMSG QSYSOPR, DSPJOBLOG, then WRKFINDING with decision impact."
    },
    {
      "id": "CLAIMS-010",
      "title": "Can You Map COSO to the Control Atlas?",
      "persona": "IT auditor / GRC analyst",
      "briefing": "The control owner claims COSO control environment components are reflected in IBM i evidence and the lab control atlas. Sign on as AUDIT, open GO WORKSHOP, review WRKCTRL, collect green-screen evidence, MAPCTRL a finding to LCL-AC-01, and document decision impact in WRKFINDING."
    }
  ],
