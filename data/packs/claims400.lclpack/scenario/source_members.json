      "     A            EMPNO          8A",
      "     A            PAYRATE        7P 2"
    ]
  },
  {
    "library": "CLAIMS400",
    "file": "QCMDSRC",
    "member": "RUNAUDRPT",
    "sourceType": "CMD",
    "text": "Run audit report command",
    "lines": [
      "CMD PROMPT('Run audit report')",
      " PARM KWD(LIB) TYPE(*CHAR) LEN(10) DFT(CLAIMS400)",
      " PARM KWD(OUTQ) TYPE(*CHAR) LEN(10) DFT(QPRINT)"
    ]
  },
  {
    "library": "CLAIMS400",
    "file": "QSQLSRC",
    "member": "USERAUTH",
    "sourceType": "SQL",
    "text": "User authority SQL",
    "lines": [
      "SELECT user_name, special_authorities",
      "FROM qsys2.user_info",
      "WHERE special_authorities LIKE '%*ALLOBJ%';"
    ]
  }
