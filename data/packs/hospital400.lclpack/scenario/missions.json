{
  "missions": [
    {
      "id": "HOSPITAL-001",
      "title": "Sensitive Object Authority Review",
      "briefing": "Determine whether sensitive operational files have excessive authority exposure.",
      "persona": "IT auditor / GRC analyst"
    },
    {
      "id": "HOSPITAL-002",
      "title": "Can You Prove Hospital Privacy Operations?",
      "briefing": "The control owner claims PHI on HOSPITAL400 is governed through object authority, file layout, payroll batch jobs, and IFS integration paths. Sign on as AUDIT and follow the ISO 27701 Clause 8 evidence chain on this system.",
      "persona": "IT auditor / GRC analyst"
    },
    {
      "id": "HOSPITAL-003",
      "title": "Operational Evidence and PTF Currency",
      "briefing": "Review job logs, spool output, and PTF group status for operational resilience evidence.",
      "persona": "IT auditor / operator"
    }
  ],
  "missionEvidenceRequirements": [
    {
      "missionId": "HOSPITAL-001",
      "key": "user_profiles",
      "description": "Review user profiles (WRKUSRPRF or DSPUSRPRF)",
      "commandPattern": "WRKUSRPRF|DSPUSRPRF",
      "optional": false,
      "weight": 1
    },
    {
      "missionId": "HOSPITAL-001",
      "key": "object_authority",
      "description": "Review sensitive object authority",
      "commandPattern": "DSPOBJAUT|WRKOBJ",
      "optional": false,
      "weight": 1
    },
    {
      "missionId": "HOSPITAL-001",
      "key": "audit_journal",
      "description": "Review audit journal entries",
      "commandPattern": "DSPJRN|DSPAUDJRNE",
      "optional": false,
      "weight": 1
    },
    {
      "missionId": "HOSPITAL-002",
