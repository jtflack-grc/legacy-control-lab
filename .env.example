# TN5250 TCP port (IronTerm connects via websockify → this port)
TN5250_PORT=8023

# Optional direct WebSocket port (not used by IronTerm)
WS_PORT=8024

# websockify listen port (IronTerm bridge URL: ws://localhost:6080/)
WEBSOCKIFY_PORT=6080

# IronTerm static file server
HTTP_PORT=8080
# Bind addresses (default loopback — set 0.0.0.0 only on a trusted LAN)
# HTTP_BIND_HOST=127.0.0.1
# TN5250_BIND_HOST=127.0.0.1
# WEBSOCKIFY_BIND_HOST=127.0.0.1
SERVE_IRONTERM=true

# System name shown on sign-on screen
SYSTEM_NAME=CLAIMS400

# Scenario pack under data/scenarios/{SCENARIO_ID}/
SCENARIO_ID=claims400

# SQLite scenario database (auto-created and seeded on first run)
DATABASE_PATH=./data/claims400.db

# Log every inbound/outbound TN5250 frame
DEV_FRAME_LOG=true

# standard = core mission data; dense = expanded jobs, source, catalog breadth
LCL_REALISM_MODE=standard

# When true (Linux/Docker), WRKACTJOB merges live ps process rows as IBM i-style jobs
LIVE_HOST_JOBS=false

# PASE / QOpenSys root inside the container (maps /QOpenSys in qshell to this path)
QOPENSYS_ROOT=./data/qopensys

# Optional POSIX shell for local non-Docker development.
# Docker users should leave this unset.
# QSH_SHELL=wsl

# QSH safety: synthetic (default) = partition /qopensys mirror only; host = real shell (local dev); disabled = off
LCL_QSH_MODE=synthetic
