  "missions": [
    {
      "id": "CLAIMS-001",
      "title": "Can You Prove IBM i Security?",
      "persona": "IT auditor / GRC analyst",
      "briefing": "The control owner claims privileged access on CLAIMS400 is reviewed quarterly, restricted to approved administrators, and monitored through audit logging. Sign on as AUDIT, inspect the available evidence, and determine whether the control claim is defensible."
    }
  ],
  "missionEvidenceRequirements": [
    {
      "missionId": "CLAIMS-001",
      "key": "user_profiles",
      "description": "Review user profiles (WRKUSRPRF or DSPUSRPRF)",
      "commandPattern": "WRKUSRPRF|DSPUSRPRF",
      "optional": false,
      "weight": 1
    },
    {
      "missionId": "CLAIMS-001",
      "key": "qsecurity",
      "description": "Display system value QSECURITY",
      "commandPattern": "DSPSYSVAL:QSECURITY",
      "optional": false,
      "weight": 1
    },
    {
      "missionId": "CLAIMS-001",
      "key": "qaudctl",
      "description": "Display system value QAUDCTL",
      "commandPattern": "DSPSYSVAL:QAUDCTL",
      "optional": false,
      "weight": 1
    },
    {
      "missionId": "CLAIMS-001",
      "key": "paymst_authority",
      "description": "Review PAYROLL/PAYMST object authority",
      "commandPattern": "DSPOBJAUT:PAYROLL/PAYMST|WRKOBJ",
      "optional": false,
      "weight": 1
    },
    {
      "missionId": "CLAIMS-001",
      "key": "audit_journal",
      "description": "Review QAUDJRN audit journal entries",
      "commandPattern": "DSPJRN|DSPAUDJRNE|DSPSECAUD",
      "optional": false,
      "weight": 1
    },
    {
      "missionId": "CLAIMS-001",
      "key": "optional_ops",
      "description": "Optional: DSPJOBLOG or DSPMSG QSYSOPR",
      "commandPattern": "DSPJOBLOG|DSPMSG",
      "optional": true,
      "weight": 1
    }
  ],
  "missionExpectedFindings": [
    {
      "missionId": "CLAIMS-001",
      "key": "backupadm_stale",
      "description": "BACKUPADM remains enabled with *ALLOBJ and *SAVSYS despite stale last signon.",
      "matchPatterns": ["backupadm", "allobj", "savsys", "stale", "privileged"],
      "weight": 1
    },
    {
      "missionId": "CLAIMS-001",
      "key": "oldvendor_enabled",
      "description": "OLDVENDOR remains enabled with *JOBCTL and authority failure activity.",
      "matchPatterns": ["oldvendor", "vendor", "jobctl", "enabled", "authority failure"],
      "weight": 1
    },
    {
      "missionId": "CLAIMS-001",
      "key": "paymst_public_auth",
      "description": "PAYROLL/PAYMST has excessive public authority.",
      "matchPatterns": ["paymst", "payroll", "public authority", "excessive", "change"],
      "weight": 1
    },
    {
      "missionId": "CLAIMS-001",
      "key": "qsecurity_insufficient",
      "description": "QSECURITY=40 is not sufficient proof of effective access governance.",
      "matchPatterns": ["qsecurity", "security level", "40", "not sufficient", "governance"],
      "weight": 1
    },
    {
      "missionId": "CLAIMS-001",
      "key": "audit_no_review_proof",
      "description": "Audit evidence exists but does not prove quarterly review/recertification.",
      "matchPatterns": ["quarterly", "review", "recertification", "does not prove", "audit evidence"],
      "weight": 1
    }
  ]
}
