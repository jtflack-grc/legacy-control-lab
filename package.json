{
  "name": "legacy-control-lab",
  "version": "1.0.0-rc1",
  "description": "A local IBM i-style governance and security range.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "trainer": "tsx src/trainer/cli.ts",
    "websockify": "tsx src/websockifyBridge.ts",
    "build": "tsc && node scripts/copyRuntimeAssets.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run trainer -- --strict-coverage && npm run phase:audit && npm run command:metadata-audit && npm run metadata:honesty && npm run authority:audit && npm run screen:fidelity-audit && npm run screen:layout-audit && npm run phase65:acceptance",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "db:seed": "tsx src/db/seed.ts",
    "validate:scenario": "tsx scripts/validate-scenario.ts",
    "validate:range": "tsx scripts/validate-range.ts",
    "create:scenario": "tsx scripts/create-scenario.ts",
    "create:mission": "tsx scripts/create-mission.ts",
    "create:campaign": "tsx scripts/create-campaign.ts",
    "package:scenario": "tsx scripts/package-scenario.ts",
    "package:campaign": "tsx scripts/package-scenario.ts",
    "import:scenario": "tsx scripts/import-scenario.ts",
    "expand:catalog": "tsx scripts/expand-phase6-catalog.ts",
    "enrich:catalog": "tsx scripts/enrich-command-catalog.ts",
    "promote:catalog": "tsx scripts/promote-catalog-commands.ts",
    "enrich:catalog-metadata": "tsx scripts/enrich-catalog-metadata.ts",
    "update:deep-handlers": "tsx scripts/update-deep-command-handlers.ts",
    "mark:infinite-depth": "tsx scripts/mark-infinite-depth.ts",
    "command:coverage": "tsx scripts/command-coverage.ts",
    "phase:audit": "tsx scripts/phase-audit.ts",
    "command:metadata-audit": "tsx scripts/command-metadata-audit.ts",
    "menu:navigation-audit": "tsx scripts/menu-navigation-audit.ts",
    "authority:audit": "tsx scripts/authority-audit.ts",
    "screen:fidelity-audit": "tsx scripts/screen-fidelity-audit.ts",
    "screen:layout-audit": "tsx scripts/screen-layout-audit.ts",
    "screen:attribute-audit": "tsx scripts/screen-attribute-audit.ts",
    "screen:pfkey-audit": "tsx scripts/screen-pfkey-audit.ts",
    "screen:golden-report": "tsx scripts/screen-golden-report.ts",
    "enrich:golden-audit": "tsx scripts/enrich-golden-audit.ts",
    "phase65:acceptance": "tsx scripts/phase65-acceptance.ts",
    "audit:grc-packs": "tsx scripts/audit-grc-packs.ts",
    "ingest:grc-corpus": "tsx scripts/ingest-grc-corpus.ts",
    "check:naming": "tsx scripts/checkNaming.ts",
    "check:release-hygiene": "tsx scripts/checkReleaseHygiene.ts",
    "docker:up": "docker compose up --build",
    "clean:generated": "tsx scripts/clean.ts generated",
    "clean:dist": "tsx scripts/clean.ts dist",
    "clean:legacy": "tsx scripts/clean.ts legacy",
    "clean:all": "tsx scripts/clean.ts all",
    "measure:disk": "tsx scripts/measureWorkspace.ts",
    "clean": "npm run clean:generated",
    "setup:qsh": "tsx scripts/setupQshShell.ts",
    "trainer:setup": "tsx scripts/setupTrainer.ts",
    "doctor": "tsx scripts/setupTrainer.ts",
    "demo:reset": "tsx scripts/demoReset.ts",
    "demo:seed": "tsx src/db/seed.ts --force",
    "demo:verify": "tsx scripts/demoVerify.ts",
    "health": "tsx scripts/healthCheck.ts",
    "preflight": "npm run check && npm run build && npm run validate:range && npm run command:coverage && npm run demo:verify && npm run check:naming && npm run check:release-hygiene && npm run check:audit",
    "release:check": "tsx scripts/releaseCheck.ts",
    "capture:screenshots": "tsx scripts/screenshotTrainer.ts",
    "metrics:reconcile": "tsx scripts/reconcileMetrics.ts",
    "copy:audit": "tsx scripts/copyAudit.ts",
    "release:candidate": "tsx scripts/releaseCandidate.ts",
    "import:ibm74-reference": "tsx scripts/import-ibm74-reference.ts",
    "enrich:ibm74-reference": "tsx scripts/enrich-ibm74-reference.ts",
    "ibm74:probe-trainer": "tsx scripts/run-ibm74-probe-trainer.ts",
    "ibm74:sync": "tsx scripts/sync-catalog-from-reference.ts",
    "ibm74:probes": "tsx scripts/generate-parameter-probes.ts",
    "metadata:honesty": "tsx scripts/metadataHonestyAudit.ts",
    "ibm74:fidelity": "tsx scripts/ibm74-fidelity-audit.ts",
    "release:fidelity": "tsx scripts/releaseFidelity.ts",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "ibm-i",
    "tn5250",
    "5250",
    "governance",
    "audit"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "playwright": "^1.60.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
