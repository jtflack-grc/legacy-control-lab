{
  "name": "legacy-control-lab",
  "version": "1.0.0",
  "description": "A local IBM i-style governance and security range.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "trainer": "tsx src/trainer/cli.ts",
    "websockify": "tsx src/websockifyBridge.ts",
    "build": "tsc && node scripts/copyRuntimeAssets.mjs",
    "start": "node dist/server.js",
    "db:seed": "tsx src/db/seed.ts",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "check:release-hygiene": "tsx scripts/checkReleaseHygiene.ts",
    "docker:up": "docker compose up --build"
  },
  "keywords": [
    "ibm-i",
    "tn5250",
    "5250",
    "governance",
    "audit"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "playwright": "^1.60.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
